# Example Environment Configuration
# 이 파일을 복사하여 사용하세요: cp example.env myname.env

# ============================================
# Container Settings (필수)
# ============================================
USER_ID={user_id}
PROJECT_NAME={project_name}

# ============================================
# 수정할 필요 없음.
# ============================================
COMPOSE_PROJECT_NAME=${PROJECT_NAME}
CONTAINER_NAME=${PROJECT_NAME}
USER_WORKDIR=/data/${USER_ID}/${PROJECT_NAME}

# ============================================
# Git Configuration (권장)
# ============================================
GIT_USER_NAME={name}
GIT_USER_EMAIL={your.email@example.com}

# ============================================
# API Keys or ENV (선택사항)
# ============================================
# Weights & Biases (https://wandb.ai/settings)
# WANDB_API_KEY=

# HuggingFace Token (https://huggingface.co/settings/tokens)
# HF_TOKEN=

# OpenAI API Key (https://platform.openai.com/api-keys)
# OPENAI_API_KEY=

# ============================================
# 사용 예시
# ============================================
# 1. 파일을 복사/수정: cp example.env jyp.env
# 2. README.md 보고 docker compose 실행

